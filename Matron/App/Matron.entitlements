<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Release entitlements for the iOS target (TestFlight / App Store
	builds). Hand-managed — see the project.yml comment at the Matron
	target's settings.configs for why the xcodegen `entitlements:` block
	is not used. Debug builds use Matron.Debug.entitlements, identical
	except `aps-environment: development`.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.chat.matron</string>
	</array>
	<!--
		Keychain access group for the signed-in session
		(`KeychainStore.sessionStore()`). Mirrors the Mac entitlement's
		group entry. `chat.matron` (NOT `chat.matron.app`) so the app's
		extensions can be granted the same group: the share extension
		declares this same single entry and reads the same item.
		iOS Simulator without a signing team cannot resolve
		`$(AppIdentifierPrefix)` and gets `errSecMissingEntitlement
		(-34018)` on every keychain op; the session then falls back to a
		file (`SessionStores.live`).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)chat.matron</string>
	</array>
	<!--
		APNs entitlement. Without this,
		`UIApplication.registerForRemoteNotifications()` never yields a
		token, so the journal server never
		learns the token and APNs delivery never starts. iOS uses the
		bare `aps-environment` key (NOT the macOS
		`com.apple.developer.aps-environment` variant). `production`
		here pairs with App Store provisioning and the journal server
		registering the token with `environment: prod` (Release builds
		send `.prod` — see AppDependencies.pushEnvironment). A mismatch
		is rejected by APNs at send time, not at registration — hard to
		diagnose live.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
		Universal links: shareable tracker links on the journal named by
		the MATRON_APP_LINK_HOST build setting (see project.yml) open the
		app. The journal's apple-app-site-association file claims /u/*
		for this app. Release only: links tapped inside the app open
		in-app without it.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(MATRON_APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
